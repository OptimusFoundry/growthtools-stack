{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@/proto-design-system/*": [
				"../node_modules/@optimusfoundry/proto-design-system/src/*"
			],
			"@/*": ["../src/*"]
		}
	},
	"include": [
		"../src/**/*.stories.ts",
		"../src/**/*.stories.tsx",
		"../src/**/*.tsx",
		"../src/**/*.ts"
	],
	"exclude": ["../node_modules"]
}
