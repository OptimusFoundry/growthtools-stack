# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=base_user
DB_PASSWORD=base_password
DB_NAME=base_db

# Server Configuration
SERVER_PORT=8080
WEBAPP_URI=http://localhost:3000

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
TURNSTILE_SECRET_KEY=key

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
DEFAULT_EMAIL_SENDER_ADDRESS=noreply@yourdomain.com

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Stamped on every Stripe object created and matched against incoming webhook
# event metadata. Identifies which product on a shared Stripe account this server
# owns. Must match other products' values in the same account, e.g. "protoapp".
PRODUCT_NAME=protoapp

# AI Services
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Media Storage
# STORAGE_TYPE: "s3" (recommended for any env where external platforms must fetch media) or "local"
# MEDIA_PUBLIC_URL_BASE: source of truth for fetchable URLs. Concatenated with the s3_key.
#   - Dev (public S3 bucket):  https://my-bucket.s3.us-east-1.amazonaws.com
#   - Prod (private bucket via API proxy):  https://api.example.com/public/media/file
STORAGE_TYPE=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL_BASE=

# Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=webhook-events
KAFKA_CONSUMER_GROUP=webhook-consumers

# Optional: Twilio (for voice calls)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number
