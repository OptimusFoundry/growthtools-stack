# Test Environment Configuration
# Source of truth for `make test` and the CI server workflow. Sourced by the
# Makefile `test` target and by CI's store/integration test steps. Also
# auto-loaded at runtime by the integration test harness (testenv.Start).
# Values must match the isolated test stack in docker-compose.test.yml.

# Database Configuration
# Host port exposed by docker-compose.test.yml's db service (5433:5432).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=base_user
DB_PASSWORD=base_password
DB_NAME=base_db

# Server Configuration
APP_SERVER_PORT=8080
APP_WEBAPP_URI=http://localhost:3000

# Authentication (test values)
AUTH_JWT_SECRET=test-jwt-secret-for-testing-only
AUTH_GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
AUTH_GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
AUTH_TURNSTILE_SECRET_KEY=test-turnstile-key

# Email Service (test values - won't actually send emails)
EMAIL_RESEND_API_KEY=re_test_fake_key
EMAIL_SENDER_ADDRESS=test@example.com

# Payment Processing (test values)
PAYMENTS_STRIPE_SECRET_KEY=sk_test_fake_key
PAYMENTS_STRIPE_WEBHOOK_SECRET=whsec_test_fake_secret
APP_PRODUCT_NAME=meerkat

# AI Services (test values)
AI_GEMINI_API_KEY=test-google-ai-key

# Kafka
EVENTS_BROKERS=localhost:9192
EVENTS_CONSUMER_GROUP=growth-tools-consumers

# Platform static tokens (used by integration tests)
SOCIAL_THREADS_ACCESS_TOKEN=test-threads-token
