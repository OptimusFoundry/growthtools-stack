#!/usr/bin/env python3
"""Self-test for sync-env.py: registry resolution and catalog resolution.

There is no test framework in these repos and no dependency may be added, so
this is stdlib `unittest` behind a hand-rolled runner: no arguments, exit 0 on
pass, non-zero on failure, one summary line on stdout.

It must pass on BOTH stock macOS /usr/bin/python3 (3.9) and whatever python3
resolves to. Nothing in here may branch on sys.version_info.

Every fixture is built inside a tempfile.TemporaryDirectory. The live workspace
is never read: sibling discovery walks real directories, and a test pinned to
the developer's own checkout would pass or fail for the wrong reason.
"""

from __future__ import annotations

import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import sys
import tempfile
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
TARGET = HERE / "sync-env.py"

# Importing the target writes scripts/__pycache__/ into whichever product repo
# this is vendored into, and most of them do not gitignore it. A test run must
# not leave anything behind in the tree it is checking.
sys.dont_write_bytecode = True


def load_target():
    """Import sync-dev-ports.py, whose hyphenated name `import` cannot reach."""
    loader = importlib.machinery.SourceFileLoader("sync_env", str(TARGET))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


se = load_target()


class FakeResult:
    def __init__(self, returncode, stdout):
        self.returncode = returncode
        self.stdout = stdout


class SiblingDiscovery(unittest.TestCase):
    def _workspace(self, registry_dirname, schema=True):
        """Build workspace/{some-product/base-server, <registry_dirname>/registry.json}."""
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        ws = Path(tmp.name)
        product = ws / "some-product"
        (product / "base-server").mkdir(parents=True)
        reg_dir = ws / registry_dirname
        reg_dir.mkdir()
        body = {"schema_version": 1, "products": []} if schema else {"nope": 1}
        (reg_dir / "registry.json").write_text(json.dumps(body))
        return str(product), str(reg_dir / "registry.json")

    def test_finds_registry_regardless_of_directory_name(self):
        # The whole point: the next rename must not touch five repos again.
        for name in ("dev-ports", "env-registry", "renamed-yet-again"):
            product, expected = self._workspace(name)
            self.assertEqual(se.find_sibling_registry(product), expected)

    def test_ignores_a_registry_json_without_schema_version(self):
        product, _ = self._workspace("decoy", schema=False)
        self.assertIsNone(se.find_sibling_registry(product))

    def test_returns_none_when_no_sibling_holds_a_registry(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        product = Path(tmp.name) / "lonely"
        (product / "base-server").mkdir(parents=True)
        self.assertIsNone(se.find_sibling_registry(str(product)))


class ResolutionOrder(unittest.TestCase):
    def setUp(self):
        self._saved = {k: os.environ.get(k) for k in ("ENV_REGISTRY", "DEV_PORTS_REGISTRY")}
        for k in self._saved:
            os.environ.pop(k, None)
        self._tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self._tmp.cleanup)
        self.lonely = Path(self._tmp.name) / "lonely"
        (self.lonely / "base-server").mkdir(parents=True)

    def tearDown(self):
        for k, v in self._saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v

    def _registry_file(self, marker):
        path = Path(self._tmp.name) / ("registry-%s.json" % marker)
        path.write_text(json.dumps({"schema_version": 1, "marker": marker, "products": []}))
        return str(path)

    def test_explicit_argument_beats_environment(self):
        explicit = self._registry_file("explicit")
        os.environ["ENV_REGISTRY"] = self._registry_file("env")
        _, text = se.resolve_registry(explicit=explicit, root=str(self.lonely))
        self.assertEqual(json.loads(text)["marker"], "explicit")

    def test_env_registry_beats_sibling_discovery(self):
        os.environ["ENV_REGISTRY"] = self._registry_file("env")
        _, text = se.resolve_registry(root=str(self.lonely))
        self.assertEqual(json.loads(text)["marker"], "env")

    def test_legacy_env_var_still_works_and_warns(self):
        os.environ["DEV_PORTS_REGISTRY"] = self._registry_file("legacy")
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            _, text = se.resolve_registry(root=str(self.lonely))
        self.assertEqual(json.loads(text)["marker"], "legacy")
        self.assertIn("deprecated", err.getvalue())

    def test_falls_back_to_gh_and_tries_the_legacy_repo_second(self):
        # This is the test that proves the migration is safe: run BEFORE the
        # rename, the new resolver still reaches the still-named dev-ports repo.
        calls = []

        def fake(cmd, **kwargs):
            calls.append(cmd[2])
            if "env-registry" in cmd[2]:
                return FakeResult(1, "")
            return FakeResult(0, json.dumps({"schema_version": 1, "marker": "legacy-repo"}))

        label, text = se.resolve_registry(root=str(self.lonely), runner=fake)
        self.assertEqual(json.loads(text)["marker"], "legacy-repo")
        self.assertEqual(calls, [
            "repos/SAVentures/env-registry/contents/registry.json",
            "repos/SAVentures/dev-ports/contents/registry.json",
        ])
        self.assertIn("dev-ports", label)

    def test_unresolvable_registry_names_all_three_fixes(self):
        def fake(cmd, **kwargs):
            return FakeResult(1, "")

        with self.assertRaises(RuntimeError) as cm:
            se.resolve_registry(root=str(self.lonely), runner=fake)
        msg = str(cm.exception)
        for hint in ("git clone", "ENV_REGISTRY", "gh auth login"):
            self.assertIn(hint, msg)


class ScriptFreshness(unittest.TestCase):
    def test_sha256_is_stable_across_calls(self):
        self.assertEqual(se.script_sha256(), se.script_sha256())
        self.assertEqual(len(se.script_sha256()), 64)

    def test_canonical_sha_is_recorded_in_the_registry(self):
        reg_path = HERE / "registry.json"
        if not reg_path.is_file():
            self.skipTest("vendored copy — the registry lives elsewhere")
        recorded = json.loads(reg_path.read_text())["script"]["sha256"]
        self.assertEqual(
            se.script_sha256(), recorded,
            "registry.json script.sha256 is stale — run: python3 sync-env.py --print-sha")

    def test_stale_copy_is_reported_but_does_not_raise(self):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            se.check_script_freshness({"script": {"sha256": "0" * 64}})
        self.assertIn("STALE", out.getvalue())

    def test_registry_without_a_script_block_is_silent(self):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            se.check_script_freshness({})
        self.assertEqual(out.getvalue(), "")


CATALOG = {"schema_version": 1, "vars": {
    "OPENAI_API_KEY": {"scope": "shared", "secret": True, "products": "*",
                       "surfaces": ["local"]},
    "ORCA_ONLY": {"scope": "product", "secret": False, "products": ["orca"],
                  "surfaces": ["local"]},
    "STRIPE_WEBHOOK_SECRET": {"scope": "product", "secret": True, "products": "*",
                              "surfaces": ["local"], "local_differs": True},
    "DB_PORT": {"scope": "derived", "secret": False, "surfaces": ["local", "test"],
                "value": {"local": "{ports.db_dev}", "test": "{ports.db_test}"}},
    "PRODUCT_NAME": {"scope": "derived", "secret": False, "surfaces": ["local"],
                     "value": {"local": "{product}"}},
    "OPTIONAL_THING": {"scope": "product", "secret": False, "products": "*",
                       "surfaces": ["local"], "required": False},
}}
ENTRY = {"product_name": "orca", "slot": 3,
         "infra_ports": {"db_dev": 5438, "db_test": 5439}}
OTHER = {"product_name": "meerkat", "slot": 0,
         "infra_ports": {"db_dev": 5432, "db_test": 5433}}


class CatalogResolution(unittest.TestCase):
    def test_derived_values_interpolate_per_surface(self):
        got, _ = se.resolve(CATALOG, ENTRY, {}, "local")
        self.assertEqual(got["DB_PORT"], "5438")
        self.assertEqual(got["PRODUCT_NAME"], "orca")
        got_test, _ = se.resolve(CATALOG, ENTRY, {}, "test")
        self.assertEqual(got_test["DB_PORT"], "5439")

    def test_a_product_only_var_is_absent_for_other_products(self):
        got, _ = se.resolve(CATALOG, ENTRY, {"ORCA_ONLY": "x"}, "local")
        self.assertIn("ORCA_ONLY", got)
        got, _ = se.resolve(CATALOG, OTHER, {"ORCA_ONLY": "x"}, "local")
        self.assertNotIn("ORCA_ONLY", got)

    def test_a_required_var_with_no_value_is_reported_missing(self):
        _, missing = se.resolve(CATALOG, ENTRY, {}, "local")
        self.assertIn("OPENAI_API_KEY", missing)

    def test_an_optional_var_with_no_value_is_not_reported(self):
        _, missing = se.resolve(CATALOG, ENTRY, {}, "local")
        self.assertNotIn("OPTIONAL_THING", missing)

    def test_shape_only_mode_yields_names_without_values(self):
        got, missing = se.resolve(CATALOG, ENTRY, None, "local")
        self.assertIn("OPENAI_API_KEY", got)
        self.assertIsNone(got["OPENAI_API_KEY"])
        self.assertEqual(missing, [])


class ExampleRendering(unittest.TestCase):
    def test_secret_values_are_redacted_but_non_secrets_are_not(self):
        want, _ = se.resolve(CATALOG, ENTRY, {"OPENAI_API_KEY": "sk-real-secret"}, "local")
        out = se.render_example(CATALOG, want)
        self.assertNotIn("sk-real-secret", out)
        self.assertIn("OPENAI_API_KEY=" + se.REDACTED, out)
        self.assertIn("PRODUCT_NAME=orca", out)


class LocalOverrides(unittest.TestCase):
    def test_local_layer_wins_over_the_base_layer(self):
        # load_values layers base then .local; resolve just consumes the result,
        # so assert the ordering contract the caller depends on.
        merged = {}
        merged.update({"STRIPE_WEBHOOK_SECRET": "aws-live-value"})
        merged.update({"STRIPE_WEBHOOK_SECRET": "local-sandbox-value"})
        got, _ = se.resolve(CATALOG, ENTRY, merged, "local")
        self.assertEqual(got["STRIPE_WEBHOOK_SECRET"], "local-sandbox-value")


class RenamedFromMigration(unittest.TestCase):
    RENAMED_CATALOG = {"schema_version": 1, "vars": {
        "AUTH_JWT_SECRET": {"scope": "product", "secret": True, "products": "*",
                            "surfaces": ["local"], "renamed_from": "JWT_SECRET"},
    }}

    def _renamed(self):
        return se.build_renamed_map(self.RENAMED_CATALOG)

    def test_build_renamed_map(self):
        self.assertEqual(self._renamed(), {"JWT_SECRET": "AUTH_JWT_SECRET"})

    def test_old_name_is_reported_once_not_as_missing_and_extra(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        path = os.path.join(tmp.name, "env.local")
        with open(path, "w") as f:
            f.write("JWT_SECRET=abc123\n")
        want = {"AUTH_JWT_SECRET": None}
        known = {"AUTH_JWT_SECRET"}
        problems = []
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            se.check_file(path, "env.local", want, known, True, problems, self._renamed())
        self.assertEqual([p[2] for p in problems], ["stale-name"])
        out = buf.getvalue()
        self.assertNotIn("MISSING", out)
        self.assertNotIn("EXTRA", out)

    def test_apply_rewrites_the_key_in_place_preserving_its_value(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        path = os.path.join(tmp.name, "env.local")
        with open(path, "w") as f:
            f.write("JWT_SECRET=my-local-value\nOTHER=untouched\n")
        want = {"AUTH_JWT_SECRET": None}
        se.apply_env_local(path, want, self._renamed())
        lines = open(path).read().splitlines()
        self.assertIn("AUTH_JWT_SECRET=my-local-value", lines)
        self.assertNotIn("JWT_SECRET=my-local-value", lines)
        self.assertIn("OTHER=untouched", lines)


def main():
    suite = unittest.defaultTestLoader.loadTestsFromModule(sys.modules[__name__])
    result = unittest.TextTestRunner(stream=sys.stderr, verbosity=1).run(suite)
    print("sync-env selftest: %d run, %d failed, %d errored"
          % (result.testsRun, len(result.failures), len(result.errors)))
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main())
