#!/usr/bin/env python3
"""Report harness drift between growth-tools and the saas-template it was built from.

growth-tools takes its agent harness (.claude/, scripts/ tooling) FROM
OptimusFoundry/saas-template. The two repos share no git history -- the harness
was vendored in (growthtools #76) and the quiet harness was copied in at the
template tag `quiet-1` -- so this is a plain file-state diff of HEAD against
the template's current tree, not a merge-base comparison.

This script does not copy anything. It reports, per file in a fixed set of
harness-owned paths, whether the template's copy differs from ours, so a human
or an agent can decide file-by-file what to pull in. Blind directory sync is
unsafe: CLAUDE.md, webapp/CLAUDE.md and webapp/docs/PATTERNS.md are genuinely
forked (product identity, route set), and several template agents were adapted
here on copy-in (webapp/CLAUDE.md instead of webapp/AGENTS.md, no scripts/gate
or scripts/tickets, the migration plan linked on GitHub). Re-apply those
adaptations whenever you pull a newer template copy.

Usage:
    scripts/harness-drift                  # add/fetch the saas-template remote if needed, report drift
    scripts/harness-drift --since 2026-10-08   # only list template commits from this date onward
    scripts/harness-drift --remote-url https://github.com/OptimusFoundry/saas-template.git

Exit status: 0 if nothing drifted, 1 if any tracked path differs (for use in a
periodic check, not CI).
"""

from __future__ import annotations

import argparse
import subprocess
import sys

REMOTE_NAME = "saas-template"
DEFAULT_REMOTE_URL = "https://github.com/OptimusFoundry/saas-template.git"
DEFAULT_REF = "main"

# Paths owned by the harness rather than by a specific product instance. Each is
# diffed as a whole subtree (or single file); product-instance data that happens
# to live nearby (docs/TICKETS.md, docs/tickets/, docs/prds/, docs/plans/,
# docs/briefs/, docs/TRACKER.md) is deliberately excluded — that's each repo's
# own tracked backlog, not harness content. Only paths growth-tools carries are listed;
# template-only tooling (scripts/gate, scripts/tickets, plan-lint, …) is not ported here.
TRACKED_PATHS = [
    ".claude/agents/",
    ".claude/hooks/",
    ".claude/skills/",
    ".claude/settings.json",
    ".claude/commands/",
    ".claude/rules/",
    "scripts/sync-env.py",
    "scripts/sync-env-selftest",
    "scripts/harness-drift",
    "webapp/docs/TEMPLATE-PATTERNS.md",
]

# Known-forked files: real, tracked divergence rather than drift. Reported
# separately so they don't clutter the list every run.
FORKED_PATHS = {
    "CLAUDE.md": "product identity, repo structure, no AGENTS.md split or iOS track here",
    "webapp/CLAUDE.md": "growth-tools webapp guide; the template splits it into webapp/AGENTS.md",
    "webapp/docs/PATTERNS.md": "growth-tools route set",
}


def run(*args: str) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def ensure_remote(remote_url: str) -> None:
    remotes = run("git", "remote").split()
    if REMOTE_NAME not in remotes:
        subprocess.run(["git", "remote", "add", REMOTE_NAME, remote_url], check=True)
    subprocess.run(["git", "fetch", REMOTE_NAME, DEFAULT_REF], check=True, capture_output=True)


def diffstat(path: str, since: str | None) -> str:
    # Two commits directly (no dots) diffs the actual current states of both
    # sides. `A...B` (triple-dot) instead diffs merge-base(A,B)..B, which hides
    # anything HEAD changed independently since the merge-base -- a real trap
    # here, since both repos have independently renamed/deleted files under
    # .claude/agents/ since they diverged.
    args = ["git", "diff", "--stat", "HEAD", f"{REMOTE_NAME}/{DEFAULT_REF}", "--", path]
    out = run(*args).strip()
    return out


def commits_touching(path: str, since: str | None) -> list[str]:
    args = ["git", "log", f"HEAD..{REMOTE_NAME}/{DEFAULT_REF}", "--oneline"]
    if since:
        args += ["--since", since]
    args += ["--", path]
    out = run(*args).strip()
    return [l for l in out.splitlines() if l]


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--remote-url", default=DEFAULT_REMOTE_URL)
    p.add_argument("--since", default=None, help="only list commits from this date onward (git --since syntax)")
    p.add_argument("--paths", nargs="*", default=None, help="override TRACKED_PATHS for this run")
    args = p.parse_args()

    ensure_remote(args.remote_url)

    paths = args.paths or TRACKED_PATHS
    any_drift = False
    for path in paths:
        stat = diffstat(path, args.since)
        commits = commits_touching(path, args.since)
        if not stat and not commits:
            continue
        any_drift = True
        print(f"=== {path} ===")
        if commits:
            print(f"  {len(commits)} commit(s) on {REMOTE_NAME}/{DEFAULT_REF} not in HEAD:")
            for c in commits[:15]:
                print(f"    {c}")
            if len(commits) > 15:
                print(f"    ... and {len(commits) - 15} more")
        if stat:
            print("  file diff:")
            for line in stat.splitlines():
                print(f"    {line}")
        print()

    if not any_drift:
        print(f"No drift: HEAD matches {REMOTE_NAME}/{DEFAULT_REF} on all tracked paths.")

    if FORKED_PATHS:
        print("--- known forks (not drift, skipped above) ---")
        for path, why in FORKED_PATHS.items():
            print(f"  {path}: {why}")

    return 1 if any_drift else 0


if __name__ == "__main__":
    sys.exit(main())
